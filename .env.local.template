# ThothAI Local Development Configuration Template
# Copy to .env.local and configure your API keys

# =============================================
# DJANGO SECURITY (required)
# =============================================
# A random secret key for Django. In production, use a properly generated key.
SECRET_KEY=local-dev-secret-key-change-this-in-production

# =============================================
# SERVICE API KEYS
# =============================================
# API key for frontend -> backend communication
DJANGO_API_KEY=local-dev-api-key-12345

# =============================================
# AI PROVIDERS (at least one required)
# =============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OLLAMA_API_BASE=http://127.0.0.1:11434
LM_STUDIO_API_BASE=http://localhost:1234
GROQ_API_KEY=

# =============================================
# EMBEDDING (required)
# =============================================
# Options: openai, mistral, cohere
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# =============================================
# BACKEND AI MODEL
# =============================================
# ai_provider: openai|anthropic|gemini|mistral|deepseek|openrouter|ollama|lm_studio|groq
BACKEND_AI_PROVIDER=openai
BACKEND_AI_MODEL=gpt-4o-mini

# =============================================
# PORTS (match Docker for compatibility)
# =============================================
BACKEND_PORT=8200
FRONTEND_PORT=3200
SQL_GENERATOR_PORT=8180
QDRANT_PORT=6334

# =============================================
# LOGGING
# =============================================
DEBUG=TRUE
BACKEND_LOGGING_LEVEL=INFO
FRONTEND_LOGGING_LEVEL=INFO
LOGFIRE_TOKEN=

# DATABASE (PostgreSQL)
# DATABASE_URL=postgres://user:password@host:port/dbname
# DB_SCHEMA=public

# =============================================
# DATABASE PATHS (SQLite - Legacy)
# =============================================
DB_ROOT_PATH=./data
DB_NAME_LOCAL=db.sqlite3

# =============================================
# MERMAID SERVICE (Docker)
# =============================================
MERMAID_SERVICE_URL=http://localhost:8003
MERMAID_SERVICE_PORT=8003

# =============================================
# SQL GENERATOR SERVICE (local development URLs)
# =============================================
# Port for SQL Generator service
PORT=8180
# Backend URL as seen from SQL Generator  
DJANGO_API_URL=http://localhost:8200
DJANGO_SERVER=http://localhost:8200
# Vector DB connection
QDRANT_URL=http://localhost:6334
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=6334

# =============================================
# FRONTEND RUNTIME CONFIGURATION
# =============================================
# These are required by Next.js /api/config endpoint
RUNTIME_BACKEND_URL=http://localhost:8200
RUNTIME_SQL_GENERATOR_URL=http://localhost:8180

# =============================================
# ATHENA INTEGRATION (optional)
# =============================================
# Origine dell'istanza Athena autorizzata a inviare JWT via postMessage.
# Dev: http://localhost:3090 — Prod: http://localhost:8090 (o dominio pubblico)
# RICHIESTA se ThothAI è integrato nell'ecosistema Athena.
NEXT_PUBLIC_ATHENA_ORIGIN=http://localhost:3090

