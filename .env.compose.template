# ThothAI Docker Configuration
# Copy to .env.docker and configure

# =============================================
# DEPLOYMENT
# =============================================
# compose = Docker Compose | swarm = Docker Swarm
DEPLOYMENT_MODE=compose
STACK_NAME=thoth

# =============================================
# BUILD MODE
# =============================================
# build = Build locale da sorgenti
# hub = Pull immagini da Docker Hub (default)
BUILD_MODE=hub
DOCKER_REGISTRY=tylconsulting
IMAGE_VERSION=latest

# =============================================
# AI PROVIDERS (at least one required)
# =============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# =============================================
# EMBEDDING (required)
# =============================================
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# =============================================
# BACKEND AI MODEL
# =============================================
BACKEND_AI_PROVIDER=openai
BACKEND_AI_MODEL=gpt-4o-mini

# BACKEND AI FALLBACK MODEL (used when primary model returns 503)
BACKEND_AI_FALLBACK_PROVIDER=
BACKEND_AI_FALLBACK_MODEL=

# =============================================
# USERS
# =============================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=changeme123

# =============================================
# PORTS
# =============================================
WEB_PORT=8040
FRONTEND_PORT=3040
SQL_GENERATOR_PORT=8020
QDRANT_PORT=6333
MERMAID_SERVICE_PORT=8003

# =============================================
# AUTHENTICATION
# =============================================
AUTH_MODE=native
ENTRA_ENABLED=false

# =============================================
# RUNTIME
# =============================================
DEBUG=false
BACKEND_LOGGING_LEVEL=WARNING
FRONTEND_LOGGING_LEVEL=WARNING
LOGFIRE_TOKEN=

# =============================================
# DATABASE
# =============================================
# Standard connection string (overrides individual vars if set)
# DATABASE_URL=postgres://thoth_user:thoth_pass@db:5432/thoth_db
# DB_SCHEMA=public

# INTERNAL DATABASE (Docker Compose Default)
# Set to 'true' to use the internal 'db' service (PostgreSQL)
# Set to 'false' to use an external database (Host or Cloud)
POSTGRES_INTERNAL=true

# EXTERNAL DATABASE CONFIGURATION (Used if POSTGRES_INTERNAL=false)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=thoth_db
# DB_USER=thoth_user
# DB_PASSWORD=thoth_pass
# DB_HOST=host.docker.internal
# DB_PORT=5432
# DB_SCHEMA=thoth_db_swarm

# AUTOMATION
# Set to 'true' to auto-create the DB schema on startup (useful for external DBs)
AUTO_CREATE_SCHEMA=false

# =============================================
# INTERNAL (Legacy/Shared)
# =============================================
DB_ROOT_PATH=/app/data
DB_NAME_DOCKER=/app/backend_db/db.sqlite3
NODE_ENV=production
MERMAID_SERVICE_URL=http://mermaid-service:8001
