# Configurazione Silenziosa Env (Nativa direnv)
# Previene l'attivazione automatica (e rumorosa) dell'IDE
if [ -d ".venv" ]; then
    export VIRTUAL_ENV="$(pwd)/.venv"
    export PATH="${VIRTUAL_ENV}/bin:${PATH}"
    export VIRTUAL_ENV_DISABLE_PROMPT=1
fi

# ASCII Art Banner (Cyan)
if [[ $- == *i* ]]; then
    echo -e "\033[36m"
    cat <<END_BANNER
 _____ _           _   _        _    ___ 
|_   _| |__   ___ | |_| |__    / \  |_ _|
  | | | '_ \ / _ \| __| '_ \  / _ \  | | 
  | | | | | | (_) | |_| | | |/ ___ \ | | 
  |_| |_| |_|\___/ \__|_| |_/_/   \_\___|
                                         
END_BANNER
    echo -e "\033[0m"
    echo -e "Python Virtual Environment activated (.venv)"
fi

