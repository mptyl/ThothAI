# ThothAI Docker Swarm Configuration Template
# ==========================================
# This file is a template for Docker Swarm deployment configuration.
# Copy this file to 'swarm_config.env' and modify the values as needed
# before running install-swarm.sh or deploy-swarm.sh.
#
# IMPORTANT: Do not commit the actual swarm_config.env file to version control
# as it may contain sensitive information.

# Docker Configuration
# --------------------
# Your Docker Hub username for pulling images
# This is REQUIRED for Swarm deployment
DOCKER_USERNAME=your-dockerhub-username

# Name of the Docker Swarm stack
# Used to identify and manage the stack deployment
STACK_NAME=thoth

# Service Port Configuration
# --------------------------
# These ports are exposed on the host machine for accessing the services
# Modify these values if any ports are already in use on your host

# Public port for the Next.js frontend web application
# Access the ThothAI UI at: http://localhost:FRONTEND_PORT
FRONTEND_PORT=3040

# Public port for the Django backend via Nginx proxy
# Access the backend API at: http://localhost:BACKEND_PROXY_PORT/api
# Access the Django admin at: http://localhost:BACKEND_PROXY_PORT/admin
BACKEND_PROXY_PORT=8040

# Public port for the FastAPI SQL Generator service
# This service handles AI-powered SQL query generation
SQL_GENERATOR_PORT=8020

# Public port for the Qdrant vector database
# Used for storing and retrieving embeddings for context retrieval
QDRANT_PORT=6333

# Public port for the Mermaid diagram service
# Used for rendering database schema diagrams and visualizations
MERMAID_SERVICE_PORT=8003
