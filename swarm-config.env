# ThothAI Docker Swarm Configuration
# This file contains parameters used by deploy-swarm.sh and deploy-swarm.ps1

# --- General Configuration ---

# The Docker Registry URL where images are pulled from
REGISTRY_URL=registry.uni.com/tylconsulting/ThothAI

# The version of the images to deploy (default: latest)
VERSION=latest

# The name of the Docker Stack (default: thoth)
STACK_NAME=thoth

# Directory on the Swarm node where backups will be stored before deployment
BACKUP_DIR=/backup/thoth

# --- Port Configuration (External Access) ---

# Nginx Proxy Port (Gateway to Backend, Frontend, API, Admin)
# Default: 7000
WEB_PORT=7000

# Direct Frontend Access Port
# Default: 7001
FRONTEND_PORT=7001

# Direct Backend Access Port (via Proxy pass-through in some configs, or direct if exposed)
# Default: 7002
BACKEND_PORT=7002

# SQL Generator Service Port
# Default: 7003
SQL_GENERATOR_PORT=7003

# Mermaid Diagram Service Port
# Default: 7004
MERMAID_SERVICE_PORT=7004

# Qdrant Vector Database Port
# Default: 7005
QDRANT_PORT=7005
