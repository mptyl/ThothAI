# ThothAI Swarm Production Configuration
# Copy to .env.swarm and configure

# =============================================
# DEPLOYMENT
# =============================================
DEPLOYMENT_MODE=swarm
STACK_NAME=thoth
IMAGE_VERSION=latest
DOCKER_REGISTRY=tylconsulting

# =============================================
# DATA STORAGE (NFS / Bind Mounts)
# =============================================
# Path on such node where NFS is mounted or local path for single-node
THOTH_DATA_PATH=/mnt/nfs/thothai

# =============================================
# EXTERNAL DATABASE (Required for Swarm)
# =============================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=thoth_db
DB_USER=thoth_user
DB_PASSWORD=thoth_pass
DB_HOST=10.0.0.1
DB_PORT=5432
DB_SCHEMA=thoth_db_swarm

# Set to true if you want the backend to try creating the schema on startup
AUTO_CREATE_SCHEMA=true

# =============================================
# PORTS
# =============================================
WEB_PORT=80
FRONTEND_PORT=3000
SQL_GENERATOR_PORT=8020
QDRANT_PORT=6333
MERMAID_SERVICE_PORT=8003

# =============================================
# AI PROVIDERS
# =============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# =============================================
# EMBEDDING
# =============================================
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# =============================================
# BACKEND AI MODEL
# =============================================
BACKEND_AI_PROVIDER=openai
BACKEND_AI_MODEL=gpt-4o-mini

# =============================================
# SECURITY & AUTH
# =============================================
SECRET_KEY=change-me-in-production-swarm-secret-key
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password
AUTH_MODE=native
ENTRA_ENABLED=false

# =============================================
# RUNTIME
# =============================================
DEBUG=false
BACKEND_LOGGING_LEVEL=WARNING
FRONTEND_LOGGING_LEVEL=WARNING
