# ThothAI Docker Swarm Configuration
# This file contains parameters used by deploy-swarm.sh and deploy-swarm.ps1

# --- General Configuration ---
# Nome utente Docker Hub (OBBLIGATORIO)
DOCKER_USERNAME=tylconsulting

# The Docker Registry URL where images are pulled from (Docker Hub)
REGISTRY_URL=tylconsulting

# The version of the images to deploy (default: latest)
VERSION=latest

# The name of the Docker Stack (default: thothai-swarm)
STACK_NAME=thoth-swarm

# Directory on the Swarm node where backups will be stored before deployment
BACKUP_DIR=/backup/thoth

# --- Port Configuration (External Access) ---
# Swarm port range: 7000-7020

# Nginx Proxy Port (Gateway to Backend, Frontend, API, Admin)
# Default: 7010 (changed from 7000 due to AirPlay conflict on macOS)
WEB_PORT=7010

# Direct Frontend Access Port
# Default: 7001
FRONTEND_PORT=7001

# Direct Backend Access Port (via Proxy pass-through)
# Default: 7002
BACKEND_PORT=7002

# SQL Generator Service Port
# Default: 7003
SQL_GENERATOR_PORT=7003

# Mermaid Diagram Service Port
# Default: 7004
MERMAID_SERVICE_PORT=7004

# Qdrant Vector Database Port
# Default: 7005
QDRANT_PORT=7005

